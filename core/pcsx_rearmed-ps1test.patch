+/* ---- ps1-test: SPU state for the harness ----
+ * ps1test_spu_ptr(0): SPU RAM (512 KB), 1: the register area (0x1F801C00-0x1F801FFF).
+ * ps1test_spu_state(): 8 global words (ctrl, stat, transfer address, audible,
+ * new, dead channel masks, IRQ address, 0) then 24 voices x 8 words (current
+ * and loop offset in SPU RAM, envelope volume, ADSR state | flags << 8 (1 noise,
+ * 2 reverb, 4 frequency modulation), raw pitch, left and right volume, 0). */
+#ifndef EMSCRIPTEN_KEEPALIVE
+#define EMSCRIPTEN_KEEPALIVE
+#endif
+static unsigned int ps1test_spu_words[8 + 24 * 8];
+EMSCRIPTEN_KEEPALIVE void *ps1test_spu_ptr(int which)
+{
+ return which == 0 ? (void *)spu.spuMemC : which == 1 ? (void *)spu.regArea : NULL;
+}
+EMSCRIPTEN_KEEPALIVE unsigned int *ps1test_spu_state(void)
+{
+ unsigned int *w = ps1test_spu_words;
+ int ch;
+ w[0] = spu.spuCtrl; w[1] = spu.spuStat; w[2] = spu.spuAddr;
+ w[3] = spu.dwChannelsAudible; w[4] = spu.dwNewChannel; w[5] = spu.dwChannelDead;
+ w[6] = spu.pSpuIrq ? (unsigned int)(spu.pSpuIrq - spu.spuMemC) : 0xffffffff; w[7] = 0;
+ for (ch = 0; ch < MAXCHAN && spu.s_chan; ch++) {
+  const SPUCHAN *c = &spu.s_chan[ch];
+  unsigned int *v = w + 8 + ch * 8;
+  v[0] = c->pCurr ? (unsigned int)(c->pCurr - spu.spuMemC) : 0;
+  v[1] = c->pLoop ? (unsigned int)(c->pLoop - spu.spuMemC) : 0;
+  v[2] = c->ADSRX.EnvelopeVol;
+  v[3] = c->ADSRX.State | ((c->bNoise | (c->bReverb << 1) | ((c->bFMod != 0) << 2)) << 8);
+  v[4] = c->iRawPitch; v[5] = c->iLeftVolume; v[6] = c->iRightVolume; v[7] = 0;
+ }
+ return w;
+}
