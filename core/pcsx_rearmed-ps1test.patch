+/* ps1-test: run up to n instructions while halted (stops early on a hit).
+ * Returns how many ran. */
+EMSCRIPTEN_KEEPALIVE int ps1test_step(int n)
+{
+	u8 **memRLUT = psxMemRLUT;
+	int i;
+	ps1test_dbg[DBG_HALTED] = 0;
+	for (i = 0; i < n && !ps1test_dbg[DBG_HALTED]; i++)
+		execIbp(memRLUT, &psxRegs);
+	ps1test_dbg[DBG_HALTED] = 1;
+	ps1test_regs();
+	return i;
+}
