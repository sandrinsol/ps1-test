@@ -236,6 +236,173 @@ static u32 INT_ATTR fetchICache(psxRegisters *regs, u8 **memRLUT, u32 pc)
 
 static u32 (INT_ATTR *fetch)(psxRegisters *regs_, u8 **memRLUT, u32 pc) = fetchNoCache;
 
+/* ---- ps1-test debugger ----
+ * Breakpoints, watchpoints, single-stepping and a PC-sampling profiler for the
+ * ps1-test harness, driven through a block of words that JS reads and writes
+ * (ps1test_dbg_block). Only active with precise exceptions (execIbp, checkLD/ST),
+ * which the harness always enables. Word offsets: */
+#ifndef EMSCRIPTEN_KEEPALIVE
+#define EMSCRIPTEN_KEEPALIVE
+#endif
+enum {
+	DBG_FLAGS = 0,      /* 1 exec breakpoints, 2 watchpoints, 4 profiler, 8 halt on a hit */
+	DBG_HALTED = 1,     /* 1 while halted at a hit (retro_run then skips the CPU) */
+	DBG_IDLE = 2,       /* retro_run calls skipped while halted */
+	DBG_SKIP = 3,       /* don't stop on this pc once (resuming from it) */
+	DBG_NEXEC = 4, DBG_EXEC = 5,              /* up to 16 addresses */
+	DBG_NWATCH = 21, DBG_WATCH = 22,          /* 16 x { start, end, mode, op, value } */
+	DBG_NHITS = 102, DBG_TOTAL = 103, DBG_MAXHITS = 104,
+	DBG_PROF_INTERVAL = 105, DBG_PROF_N = 106, DBG_PROF_NEXT = 107,
+	DBG_REGS = 108,     /* r0-r31, lo, hi, pc, sr, cause, epc, badvaddr, cycle */
+	DBG_HIT0 = 160,     /* 256 x 16 words: kind, pc, addr, size, value, old, ra, sp,
+	                       cycle, watch/breakpoint index, v0, a0, a1, a2, a3, code */
+	DBG_WORDS = 160 + 256 * 16
+};
+#define PS1TEST_PROF_WORDS (1 << 20)
+static u32 ps1test_dbg[DBG_WORDS] = { [DBG_SKIP] = 1 };
+static u32 ps1test_prof[PS1TEST_PROF_WORDS];
+
+EMSCRIPTEN_KEEPALIVE u32 *ps1test_dbg_block(void) { return ps1test_dbg; }
+EMSCRIPTEN_KEEPALIVE u32 *ps1test_prof_buf(void) { return ps1test_prof; }
+int ps1test_dbg_halted(void) { return ps1test_dbg[DBG_HALTED]; }
+void ps1test_dbg_idle(void) { ps1test_dbg[DBG_IDLE]++; }
+
+static u32 ps1test_norm(u32 a)
+{
+	a &= 0x1fffffff;
+	return a < 0x800000 ? a & 0x1fffff : a;
+}
+
+/* Current value at a RAM/scratchpad address (0 elsewhere: no I/O side effects). */
+static u32 ps1test_peek(u32 addr, u32 size)
+{
+	u32 a = ps1test_norm(addr), v = 0, i;
+	const u8 *p;
+	if (a < 0x200000) p = (const u8 *)psxM + a;
+	else if (a >= 0x1f800000 && a < 0x1f800400) p = (const u8 *)psxH + (a & 0x3ff);
+	else return 0;
+	for (i = 0; i < size; i++) v |= (u32)p[i] << (i * 8);
+	return v;
+}
+
+static void ps1test_hit(psxRegisters *regs, u32 kind, u32 pc, u32 addr, u32 size,
+	u32 value, u32 old, u32 index)
+{
+	u32 n = ps1test_dbg[DBG_NHITS];
+	ps1test_dbg[DBG_TOTAL]++;
+	if (n < ps1test_dbg[DBG_MAXHITS] && n < 256) {
+		u32 *h = ps1test_dbg + DBG_HIT0 + n * 16;
+		h[0] = kind; h[1] = pc; h[2] = addr; h[3] = size; h[4] = value; h[5] = old;
+		h[6] = regs->GPR.n.ra; h[7] = regs->GPR.n.sp; h[8] = regs->cycle; h[9] = index;
+		h[10] = regs->GPR.n.v0; h[11] = regs->GPR.n.a0; h[12] = regs->GPR.n.a1;
+		h[13] = regs->GPR.n.a2; h[14] = regs->GPR.n.a3; h[15] = regs->code;
+		ps1test_dbg[DBG_NHITS] = n + 1;
+	}
+	if (ps1test_dbg[DBG_FLAGS] & 8) {
+		ps1test_dbg[DBG_HALTED] = 1;
+		regs->stop = 1;
+	}
+}
+
+static int ps1test_cond(u32 op, u32 v, u32 want)
+{
+	switch (op) {
+	case 1: return v == want;
+	case 2: return v != want;
+	case 3: return v < want;
+	case 4: return v > want;
+	case 5: return v <= want;
+	case 6: return v >= want;
+	}
+	return 1;
+}
+
+/* Before an instruction runs: profiler sample, then exec breakpoints.
+ * Returns 1 to halt before executing it. */
+static int ps1test_exec_hook(psxRegisters *regs, u32 pc)
+{
+	u32 flags = ps1test_dbg[DBG_FLAGS], i;
+	if (flags & 4) {
+		if ((s32)(regs->cycle - ps1test_dbg[DBG_PROF_NEXT]) >= 0) {
+			u32 n = ps1test_dbg[DBG_PROF_N];
+			if (n < PS1TEST_PROF_WORDS) {
+				ps1test_prof[n] = pc;
+				ps1test_dbg[DBG_PROF_N] = n + 1;
+			}
+			ps1test_dbg[DBG_PROF_NEXT] = regs->cycle + ps1test_dbg[DBG_PROF_INTERVAL];
+		}
+	}
+	if (!(flags & 1))
+		return 0;
+	if (pc == ps1test_dbg[DBG_SKIP]) {
+		ps1test_dbg[DBG_SKIP] = 1;
+		return 0;
+	}
+	for (i = 0; i < ps1test_dbg[DBG_NEXEC] && i < 16; i++) {
+		if (ps1test_dbg[DBG_EXEC + i] == pc) {
+			ps1test_hit(regs, 1, pc, pc, 4, intFakeFetch(pc), 0, i);
+			if (ps1test_dbg[DBG_HALTED]) {
+				ps1test_dbg[DBG_SKIP] = pc;
+				return 1;
+			}
+		}
+	}
+	return 0;
+}
+
+/* Before a load or store (regs->code is the instruction). */
+static void ps1test_mem_hook(psxRegisters *regs, u32 addr, int store)
+{
+	u32 code = regs->code, op = code >> 26, size, a, i, value = 0, old;
+	switch (op & 7) {
+	case 0: case 4: size = 1; break;   /* lb sb lbu */
+	case 1: case 5: size = 2; break;   /* lh sh lhu */
+	default: size = 4; addr &= ~3; break;
+	}
+	a = ps1test_norm(addr);
+	old = ps1test_peek(addr, size);
+	if (store) {
+		if (op != 0x3a)   /* swc2: a GTE register, not a GPR */
+			value = regs->GPR.r[(code >> 16) & 31];
+		if (size < 4) value &= (1u << (size * 8)) - 1;
+	} else
+		value = old;
+	for (i = 0; i < ps1test_dbg[DBG_NWATCH] && i < 16; i++) {
+		const u32 *w = ps1test_dbg + DBG_WATCH + i * 5;
+		u32 mode = w[2];
+		if (a + size <= w[0] || a >= w[1])
+			continue;
+		if (!(mode & (store ? 2 : 1)))
+			continue;
+		if (store && (mode & 4) && value == old)
+			continue;
+		if (!ps1test_cond(w[3], value, w[4]))
+			continue;
+		ps1test_hit(regs, store ? 4 : 2, regs->pc - 4, addr, size, value, old, i);
+		ps1test_dbg[DBG_SKIP] = 1;
+		break;
+	}
+}
+
+/* Registers into DBG_REGS (with a pending delayed load shown as done). */
+EMSCRIPTEN_KEEPALIVE void ps1test_regs(void)
+{
+	u32 *r = ps1test_dbg + DBG_REGS;
+	int i;
+	for (i = 0; i < 34; i++)
+		r[i] = psxRegs.GPR.r[i];
+	for (i = 0; i < 2; i++)
+		if (psxRegs.dloadReg[i])
+			r[psxRegs.dloadReg[i]] = psxRegs.dloadVal[i];
+	r[0] = 0;
+	r[34] = psxRegs.pc;
+	r[35] = psxRegs.CP0.n.SR;
+	r[36] = psxRegs.CP0.n.Cause;
+	r[37] = psxRegs.CP0.n.EPC;
+	r[38] = psxRegs.CP0.n.BadVAddr;
+	r[39] = psxRegs.cycle;
+}
+
