 struct psx_gpu gpu;
 
+/* ---- ps1-test instrumentation ----
+ * A log of what the GPU was sent, for the ps1-test harness: GP0 packets (with
+ * the RAM address of each DMA-chain packet), GP1 writes, chain starts and CPU
+ * exceptions. The harness turns it on for one frame and reads it back from JS.
+ * Entry: header word (type << 28 | source << 24 | word count), an address word,
+ * then the words. Types: 1 GP0 (source 0 CPU, 1 DMA block, 2 DMA chain),
+ * 2 GP1, 3 chain start, 4 CPU exception (cause, EPC, BadVaddr). */
+#ifndef EMSCRIPTEN_KEEPALIVE
+#define EMSCRIPTEN_KEEPALIVE
+#endif
+#define PS1TEST_LOG_WORDS (1 << 19)
+static uint32_t ps1test_log[PS1TEST_LOG_WORDS];
+static int ps1test_log_used, ps1test_log_on, ps1test_log_overflow;
+extern signed char *psxM, *psxH, *psxR;
+
+static void ps1test_put(uint32_t type, uint32_t src, uint32_t addr, const uint32_t *w, int n)
+{
+  if (!ps1test_log_on)
+    return;
+  if (ps1test_log_used + 2 + n > PS1TEST_LOG_WORDS) {
+    ps1test_log_overflow = 1;
+    return;
+  }
+  ps1test_log[ps1test_log_used++] = (type << 28) | (src << 24) | (n & 0xffffff);
+  ps1test_log[ps1test_log_used++] = addr;
+  memcpy(ps1test_log + ps1test_log_used, w, n * 4);
+  ps1test_log_used += n;
+}
+
+/* PS1 address of a pointer into main RAM (0 if it isn't one). */
+static uint32_t ps1test_ram_addr(const void *p)
+{
+  const signed char *c = p;
+  if (psxM && c >= psxM && c < psxM + 0x200000)
+    return 0x80000000u | (uint32_t)(c - psxM);
+  return 0;
+}
+
+void ps1test_log_exception(uint32_t cause, uint32_t epc, uint32_t badvaddr)
+{
+  uint32_t w[3] = { cause, epc, badvaddr };
+  ps1test_put(4, 0, 0, w, 3);
+}
+
+EMSCRIPTEN_KEEPALIVE void ps1test_log_ctl(int on)
+{
+  ps1test_log_used = 0;
+  ps1test_log_overflow = 0;
+  ps1test_log_on = on;
+}
+EMSCRIPTEN_KEEPALIVE uint32_t *ps1test_log_buf(void) { return ps1test_log; }
+EMSCRIPTEN_KEEPALIVE int ps1test_log_len(void) { return ps1test_log_used; }
+EMSCRIPTEN_KEEPALIVE int ps1test_log_flags(void) { return ps1test_log_on | (ps1test_log_overflow << 1); }
+/* 0: main RAM (2 MB), 1: scratchpad + I/O (64 KB), 2: VRAM (1 MB), 3: BIOS (512 KB) */
+EMSCRIPTEN_KEEPALIVE void *ps1test_ptr(int which)
+{
+  switch (which) {
+  case 0: return psxM;
+  case 1: return psxH;
+  case 2: return gpu.vram;
+  case 3: return psxR;
+  }
+  return NULL;
+}
+
