<?xml version="1.0" encoding="utf-8"?>
<!-- mkpsxiso disc layout. Paths are relative to the build directory. -->
<iso_project>
	<track type="data">
		<identifiers
			system        ="PLAYSTATION"
			volume        ="GAME"
			volume_set    ="GAME"
			publisher     ="HOMEBREW"
			data_preparer ="PSN00BSDK ${PSN00BSDK_VERSION}"
			application   ="PLAYSTATION"
			copyright     ="README.TXT;1"
		/>
		<directory_tree>
			<file name="SYSTEM.CNF" type="data" source="${PROJECT_SOURCE_DIR}/system.cnf" />
			<file name="GAME.EXE"   type="data" source="game.exe" />
			<!-- Padding after the last file: real drives misread the very end of a disc. -->
			<dummy sectors="150"/>
		</directory_tree>
	</track>
</iso_project>
